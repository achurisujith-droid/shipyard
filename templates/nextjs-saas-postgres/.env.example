# Copy this file to `.env` and fill it in. `.env` is never committed and never
# leaves your machine — Shipyard treats it as secret material and will not read
# values out of it, put it in a support bundle, or send it anywhere.

# Where your database lives. Shipyard runs one locally for you.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app?schema=public"

# The address the app is served from. Used to build links in emails.
APP_URL="http://localhost:3000"
