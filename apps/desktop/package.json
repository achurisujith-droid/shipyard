{
  "name": "@shipyard/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Shipyard \u2014 describe the app you want, and watch it get built",
  "productName": "Shipyard",
  "author": "Shipyard",
  "homepage": "https://github.com/achurisujith-droid/shipyard",
  "license": "UNLICENSED",
  "main": "dist/main/index.js",
  "scripts": {
    "build:main": "tsc -b tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "dev": "node scripts/dev.mjs",
    "start": "electron .",
    "icon": "electron scripts/make-icon.mjs",
    "package": "npm run build && electron-builder --config electron-builder.yml",
    "package:dir": "npm run build && electron-builder --config electron-builder.yml --dir",
    "smoke": "node scripts/smoke.mjs",
    "smoke:session": "node scripts/smoke.mjs --session",
    "test": "tsx scripts/test-runner.mts",
    "toolchain": "node scripts/fetch-toolchain.mjs",
    "test:stack": "tsx scripts/test-stack.mts",
    "test:restart": "tsx scripts/test-restart.mts",
    "try": "tsx scripts/try-project.mts",
    "check:contrast": "node scripts/check-contrast.mjs",
    "test:intake": "tsx scripts/test-intake.mts",
    "test:metadata": "tsx scripts/test-metadata.mts"
  },
  "dependencies": {
    "@shipyard/capability-resolver": "*",
    "@shipyard/cli-bridge": "*",
    "@shipyard/component-library": "*",
    "@shipyard/component-matcher": "*",
    "@shipyard/connectors": "*",
    "@shipyard/project-contracts": "*",
    "@shipyard/readiness": "*",
    "@shipyard/rulebook": "*",
    "@shipyard/shared": "*",
    "@shipyard/skills-registry": "*",
    "@shipyard/task-composer": "*",
    "@shipyard/verification-runner": "*",
    "better-sqlite3": "^13.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "43.2.0",
    "electron-builder": "^26.15.3",
    "vite": "^8.2.0"
  }
}
